{
  "name": "Watchlist Daily Run (Greenhouse)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Daily Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "companies",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "active",
              "condition": "eq",
              "keyValue": "true"
            },
            {
              "keyName": "ats_type",
              "condition": "eq",
              "keyValue": "greenhouse"
            }
          ]
        }
      },
      "id": "get-companies",
      "name": "Get active Greenhouse companies",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "split-companies",
      "name": "Split per company",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "=https://boards-api.greenhouse.io/v1/boards/{{$json.ats_slug}}/jobs?content=true",
        "options": {
          "response": {
            "response": {
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "fetch-greenhouse",
      "name": "Fetch Greenhouse jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const company = $('Split per company').item.json;\nconst jobs = $input.first().json.jobs || [];\n\nconst decode = s => s\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/&nbsp;/g, ' ');\n\nreturn jobs.map(j => ({\n  json: {\n    company_id: company.id,\n    company_name: company.name,\n    ats_job_id: String(j.id),\n    title: j.title,\n    location: j.location?.name || null,\n    url: j.absolute_url,\n    posted_at: j.updated_at,\n    raw_jd: decode(j.content || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 6000)\n  }\n}));"
      },
      "id": "normalize-greenhouse",
      "name": "Normalize Greenhouse jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "jobs",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "company_id",
              "condition": "eq",
              "keyValue": "={{$json.company_id}}"
            },
            {
              "keyName": "ats_job_id",
              "condition": "eq",
              "keyValue": "={{$json.ats_job_id}}"
            }
          ]
        }
      },
      "id": "check-existing",
      "name": "Check if job exists",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 300],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{$json.length}}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "is-new-job",
      "name": "Is new job?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{$credentials.anthropicApi.apiKey}}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'claude-sonnet-4-6',\n  max_tokens: 400,\n  system: [{\n    type: 'text',\n    text: $vars.SCORING_PROMPT,\n    cache_control: { type: 'ephemeral' }\n  }],\n  messages: [{\n    role: 'user',\n    content: 'JOB TITLE: ' + $json.title + '\\nLOCATION: ' + ($json.location || 'unspecified') + '\\nCOMPANY: ' + $json.company_name + '\\n\\nJOB DESCRIPTION:\\n' + $json.raw_jd\n  }]\n}) }}",
        "options": {}
      },
      "id": "score-with-claude",
      "name": "Score with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst job = $('Is new job?').item.json;\nconst text = item.content[0].text;\n\n// Strip markdown code fences if present\nconst clean = text.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(clean);\n\nreturn {\n  json: {\n    job,\n    match: {\n      score: parsed.score,\n      role_fit: parsed.role_fit,\n      level_fit: parsed.level_fit,\n      location_fit: parsed.location_fit,\n      reasoning: parsed.reasoning\n    }\n  }\n};"
      },
      "id": "parse-score",
      "name": "Parse Claude output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "jobs",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "company_id", "fieldValue": "={{$json.job.company_id}}" },
            { "fieldId": "ats_job_id", "fieldValue": "={{$json.job.ats_job_id}}" },
            { "fieldId": "title", "fieldValue": "={{$json.job.title}}" },
            { "fieldId": "location", "fieldValue": "={{$json.job.location}}" },
            { "fieldId": "url", "fieldValue": "={{$json.job.url}}" },
            { "fieldId": "posted_at", "fieldValue": "={{$json.job.posted_at}}" },
            { "fieldId": "raw_jd", "fieldValue": "={{$json.job.raw_jd}}" }
          ]
        }
      },
      "id": "insert-job",
      "name": "Insert job",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2220, 200],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "matches",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "job_id", "fieldValue": "={{$json.id}}" },
            { "fieldId": "score", "fieldValue": "={{$('Parse Claude output').item.json.match.score}}" },
            { "fieldId": "role_fit", "fieldValue": "={{$('Parse Claude output').item.json.match.role_fit}}" },
            { "fieldId": "level_fit", "fieldValue": "={{$('Parse Claude output').item.json.match.level_fit}}" },
            { "fieldId": "location_fit", "fieldValue": "={{$('Parse Claude output').item.json.match.location_fit}}" },
            { "fieldId": "reasoning", "fieldValue": "={{$('Parse Claude output').item.json.match.reasoning}}" }
          ]
        }
      },
      "id": "insert-match",
      "name": "Insert match",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2440, 200],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "jobs",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{$json[0].id}}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "last_seen_at", "fieldValue": "={{$now.toISO()}}" }
          ]
        }
      },
      "id": "touch-existing",
      "name": "Update last_seen_at",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1780, 400],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase (service_role)"
        }
      }
    }
  ],
  "connections": {
    "Daily Cron": { "main": [[{ "node": "Get active Greenhouse companies", "type": "main", "index": 0 }]] },
    "Get active Greenhouse companies": { "main": [[{ "node": "Split per company", "type": "main", "index": 0 }]] },
    "Split per company": { "main": [[{ "node": "Fetch Greenhouse jobs", "type": "main", "index": 0 }]] },
    "Fetch Greenhouse jobs": { "main": [[{ "node": "Normalize Greenhouse jobs", "type": "main", "index": 0 }]] },
    "Normalize Greenhouse jobs": { "main": [[{ "node": "Check if job exists", "type": "main", "index": 0 }]] },
    "Check if job exists": { "main": [[{ "node": "Is new job?", "type": "main", "index": 0 }]] },
    "Is new job?": {
      "main": [
        [{ "node": "Score with Claude", "type": "main", "index": 0 }],
        [{ "node": "Update last_seen_at", "type": "main", "index": 0 }]
      ]
    },
    "Score with Claude": { "main": [[{ "node": "Parse Claude output", "type": "main", "index": 0 }]] },
    "Parse Claude output": { "main": [[{ "node": "Insert job", "type": "main", "index": 0 }]] },
    "Insert job": { "main": [[{ "node": "Insert match", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "_setup_notes": "Before activating: (1) Add Supabase credential with service_role key, replace REPLACE_WITH_SUPABASE_CREDENTIAL_ID throughout. (2) Add Anthropic credential. (3) Set workflow variable SCORING_PROMPT to the contents of prompts/scoring-prompt.md with your master context inlined. (4) Test-run manually before enabling cron."
}
